{
  "name": "naranhi",
  "version": "0.3.0",
  "description": "보행 충돌 위험 평가 통합 라이브러리 — 인식(nrh-detector) + 분석(naranhi-collision-assessor) + 모델을 한 패키지에 담았다",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./model": "./src/model.js",
    "./web": "./src/web.js",
    "./native": "./src/native.js",
    "./model/*": "./model/*"
  },
  "bin": {
    "naranhi": "./bin/naranhi.mjs"
  },
  "files": [
    "src",
    "bin",
    "model",
    "test/*.test.js",
    "README.md",
    "LICENSE",
    "NOTICE-nrh-detector.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "collision",
    "ttc",
    "time-to-collision",
    "pedestrian",
    "naranhi",
    "risk-assessment",
    "object-detection",
    "onnx"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node bin/naranhi.mjs --help"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "ffmpeg-static": "^5.3.0",
    "naranhi-collision-assessor": "https://github.com/J4VIS-2026/nrh-analysis/releases/download/v0.3.0/naranhi-collision-assessor-0.3.0.tgz",
    "nrh-detector": "https://github.com/J4VIS-2026/nrh-detector/releases/download/v0.10.1/nrh-detector-0.10.1.tgz",
    "onnxruntime-node": "^1.29.0",
    "onnxruntime-web": "^1.27.0"
  },
  "bundleDependencies": [
    "@derhuerst/http-basic",
    "@napi-rs/canvas",
    "@napi-rs/canvas-win32-x64-msvc",
    "@protobufjs/aspromise",
    "@protobufjs/base64",
    "@protobufjs/codegen",
    "@protobufjs/eventemitter",
    "@protobufjs/fetch",
    "@protobufjs/float",
    "@protobufjs/path",
    "@protobufjs/pool",
    "@protobufjs/utf8",
    "adm-zip",
    "agent-base",
    "buffer-from",
    "caseless",
    "concat-stream",
    "debug",
    "define-data-property",
    "define-properties",
    "env-paths",
    "es-define-property",
    "es-errors",
    "escape-string-regexp",
    "ffmpeg-static",
    "flatbuffers",
    "global-agent",
    "globalthis",
    "gopd",
    "guid-typescript",
    "has-property-descriptors",
    "http-response-object",
    "https-proxy-agent",
    "inherits",
    "long",
    "matcher",
    "ms",
    "naranhi-collision-assessor",
    "nrh-detector",
    "object-keys",
    "onnxruntime-common",
    "onnxruntime-node",
    "onnxruntime-web",
    "parse-cache-control",
    "platform",
    "progress",
    "protobufjs",
    "readable-stream",
    "safe-buffer",
    "semver",
    "serialize-error",
    "string_decoder",
    "type-fest",
    "typedarray",
    "undici-types",
    "util-deprecate"
  ],
  "allowScripts": {
    "onnxruntime-node@1.29.0": true,
    "ffmpeg-static@5.3.0": true,
    "protobufjs@7.6.5": true
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ]
}
